      ]
    },
    {
      "id": "who5",
      "version": 1,
      "title": "Well-being (WHO-5)",
      "help": "For each statement, choose what is closest to how you have been feeling over the last two weeks.",
      "source": "WHO-5 Well-Being Index © World Health Organization, licensed CC BY-NC-SA 3.0 IGO.",
      "schedule": { "everyDays": 14 },
      "score": {
        "id": "who5_score", "label": "WHO-5 (0–100)",
        "items": ["who5_1", "who5_2", "who5_3", "who5_4", "who5_5"],
        "multiply": 4, "min": 0, "max": 100
      },
      "questions": [
        { "id": "who5_1", "version": 1, "type": "single", "label": "I have felt cheerful and in good spirits", "options": [ { "value": 5, "label": "All of the time" }, { "value": 4, "label": "Most of the time" }, { "value": 3, "label": "More than half of the time" }, { "value": 2, "label": "Less than half of the time" }, { "value": 1, "label": "Some of the time" }, { "value": 0, "label": "At no time" } ] },
