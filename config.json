        { "id": "unwell", "version": 1, "type": "yesno", "label": "Ill or unwell today (e.g. cold, infection)?" },
        { "id": "unwell_what", "version": 1, "type": "text", "label": "What?", "showIf": { "q": "unwell", "eq": true } },
